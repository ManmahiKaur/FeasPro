# ==============================================================================
# FeasPro Environment Configuration Template
# Copy this file to .env and configure your local/production credentials.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="FeasPro - Property Development Feasibility Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# Local Development (SQLite):
DATABASE_URL="sqlite:///./feaspro.db"
# Production (PostgreSQL example):
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/feaspro"

# CORS Allowed Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'
